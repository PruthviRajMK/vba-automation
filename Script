Private Function Count_Host_Removal_Rows(ByVal wbSource As Workbook) As Long

    Count_Host_Removal_Rows = Count_Source_Data_Rows( _
        wbSource.Worksheets("Content Removal Report"), "Host Link", SOURCE_HEADER_ROW)

End Function

Private Function Count_Host_Working_Rows(ByVal wbSource As Workbook) As Long

    Count_Host_Working_Rows = Count_Source_Data_Rows( _
        wbSource.Worksheets("Working Links"), "Host Link", SOURCE_HEADER_ROW)

End Function

Private Function Count_Source_Data_Rows(ByVal ws As Worksheet, _
                                        ByVal keyHeader As String, _
                                        ByVal headerRow As Long) As Long

    Dim keyCol As Long
    Dim lastRow As Long
    Dim r As Long
    Dim countRows As Long

    keyCol = GetColumn(ws, keyHeader, headerRow)
    lastRow = GetLastRow(ws, keyCol)

    For r = headerRow + 1 To lastRow
        If Len(Trim$(CStr(ws.Cells(r, keyCol).Value))) > 0 Then
            countRows = countRows + 1
        End If
    Next r

    Count_Source_Data_Rows = countRows

End Function

Private Function Count_Status_Based_Rows(ByVal ws As Worksheet, _
                                         ByVal linkHeader As String, _
                                         ByVal requiredStatus As String) As Long

    Dim linkCol As Long
    Dim statusCol As Long
    Dim lastRow As Long
    Dim r As Long
    Dim statusText As String
    Dim countRows As Long

    linkCol = GetColumn(ws, linkHeader, SOURCE_HEADER_ROW)
    statusCol = GetColumn(ws, "Status", SOURCE_HEADER_ROW)
    lastRow = GetLastRow(ws, linkCol)

    For r = SOURCE_HEADER_ROW + 1 To lastRow
        If Len(Trim$(CStr(ws.Cells(r, linkCol).Value))) > 0 Then
            statusText = CleanHeader(ws.Cells(r, statusCol).Value)
            If InStr(1, statusText, requiredStatus, vbTextCompare) > 0 Then
                countRows = countRows + 1
            End If
        End If
    Next r

    Count_Status_Based_Rows = countRows

End Function

Private Sub Resize_Flat_Data_Area(ByVal ws As Worksheet, _
                                  ByVal keyHeader As String, _
                                  ByVal targetRows As Long)

    Dim keyCol As Long
    Dim currentRows As Long
    Dim effectiveTarget As Long

    keyCol = GetColumn(ws, keyHeader, DEST_HEADER_ROW)
    currentRows = Application.Max(1, GetLastRow(ws, keyCol) - DEST_START_ROW + 1)
    effectiveTarget = Application.Max(1, targetRows)

    If currentRows < effectiveTarget Then
        Insert_Formatted_Rows ws, DEST_START_ROW + currentRows, effectiveTarget - currentRows
    ElseIf currentRows > effectiveTarget Then
        ws.Rows((DEST_START_ROW + effectiveTarget) & ":" & _
                (DEST_START_ROW + currentRows - 1)).Delete
    End If

End Sub

Private Sub Resize_Summary_Data_Area(ByVal ws As Worksheet, _
                                     ByVal targetRows As Long)

    Dim footerRow As Long
    Dim currentRows As Long
    Dim effectiveTarget As Long

    footerRow = GetSummaryFooterRow(ws)
    currentRows = Application.Max(1, footerRow - DEST_START_ROW)
    effectiveTarget = Application.Max(1, targetRows)

    If currentRows < effectiveTarget Then
        Insert_Formatted_Rows ws, footerRow, effectiveTarget - currentRows
    ElseIf currentRows > effectiveTarget Then
        ws.Rows((DEST_START_ROW + effectiveTarget) & ":" & _
                (footerRow - 1)).Delete
    End If

End Sub

Private Sub Insert_Formatted_Rows(ByVal ws As Worksheet, _
                                  ByVal insertAtRow As Long, _
                                  ByVal rowsToInsert As Long)

    Dim templateRow As Long

    If rowsToInsert <= 0 Then Exit Sub

    templateRow = Application.Max(DEST_START_ROW, insertAtRow - 1)
    ws.Rows(insertAtRow & ":" & insertAtRow + rowsToInsert - 1).Insert Shift:=xlDown
    ws.Rows(templateRow).Copy
    ws.Rows(insertAtRow & ":" & insertAtRow + rowsToInsert - 1).PasteSpecial xlPasteFormats
    Application.CutCopyMode = False

End Sub

Private Function GetSummaryFooterRow(ByVal ws As Worksheet) As Long

    Dim serialCol As Long
    Dim lastRow As Long
    Dim r As Long

    serialCol = GetColumn(ws, "Sl. No.", DEST_HEADER_ROW)
    lastRow = GetLastRowAny(ws)

    For r = DEST_START_ROW To lastRow
        If Len(Trim$(CStr(ws.Cells(r, serialCol).Value))) > 0 And _
           Not IsNumeric(ws.Cells(r, serialCol).Value) Then
            GetSummaryFooterRow = r
            Exit Function
        End If
    Next r

    GetSummaryFooterRow = GetLastNumericRow(ws, serialCol) + 1

End Function

