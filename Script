Private Function Write_Duplicate_Host_Link_Log(ByVal wbDest As Workbook) As Long

    Dim wsLog As Worksheet
    Dim duplicateCount As Long
    Dim nextRow As Long

    Set wsLog = Reset_Log_Sheet(wbDest)

    wsLog.Range("A1:D1").Value = Array("Sheet", "Host Site Link", "Count", "Rows")
    wsLog.Range("A1:D1").Font.Bold = True

    nextRow = 2
    duplicateCount = duplicateCount + Log_Duplicates_For_Sheet( _
        wbDest.Worksheets("Host Removals"), wsLog, nextRow)
    duplicateCount = duplicateCount + Log_Duplicates_For_Sheet( _
        wbDest.Worksheets("Working Links"), wsLog, nextRow)

    If duplicateCount = 0 Then
        wsLog.Cells(2, 1).Value = "No duplicate Host Site Links found."
    End If

    wsLog.Columns("A:D").AutoFit
    Write_Duplicate_Host_Link_Log = duplicateCount

End Function

Private Function Reset_Log_Sheet(ByVal wb As Workbook) As Worksheet

    Dim ws As Worksheet

    On Error Resume Next
    Set ws = wb.Worksheets(LOG_SHEET_NAME)
    On Error GoTo 0

    If ws Is Nothing Then
        Set ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
        ws.Name = LOG_SHEET_NAME
    Else
        ws.Cells.Clear
    End If

    Set Reset_Log_Sheet = ws

End Function

Private Function Log_Duplicates_For_Sheet(ByVal wsData As Worksheet, _
                                          ByVal wsLog As Worksheet, _
                                          ByRef nextRow As Long) As Long

    Dim linkCol As Long
    Dim lastRow As Long
    Dim r As Long
    Dim key As String
    Dim counts As Object
    Dim rowsByKey As Object
    Dim item As Variant
    Dim duplicateCount As Long

    Set counts = CreateObject("Scripting.Dictionary")
    Set rowsByKey = CreateObject("Scripting.Dictionary")

    linkCol = GetColumn(wsData, "Host Site Link", DEST_HEADER_ROW)
    lastRow = GetLastRow(wsData, linkCol)

    For r = DEST_START_ROW To lastRow
        key = Trim$(CStr(wsData.Cells(r, linkCol).Value))
        If Len(key) > 0 Then
            If counts.Exists(key) Then
                counts(key) = counts(key) + 1
                rowsByKey(key) = rowsByKey(key) & ", " & r
            Else
                counts.Add key, 1
                rowsByKey.Add key, CStr(r)
            End If
        End If
    Next r

    For Each item In counts.Keys
        If counts(item) > 1 Then
            wsLog.Cells(nextRow, 1).Value = wsData.Name
            wsLog.Cells(nextRow, 2).Value = item
            wsLog.Cells(nextRow, 3).Value = counts(item)
            wsLog.Cells(nextRow, 4).Value = rowsByKey(item)
            nextRow = nextRow + 1
            duplicateCount = duplicateCount + 1
        End If
    Next item

    Log_Duplicates_For_Sheet = duplicateCount

End Function

